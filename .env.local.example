# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic
ANTHROPIC_API_KEY=

# WhatsApp
WHATSAPP_PROVIDER=mock              # mock | greenapi | twochat | twilio | whatsapp_cloud
WHATSAPP_WEBHOOK_SECRET=            # pour vérifier les signatures entrantes (Meta verify token)

# Green API (si WHATSAPP_PROVIDER=greenapi)
GREENAPI_ID_INSTANCE=               # Instance ID depuis console.green-api.com
GREENAPI_API_TOKEN=                 # API Token depuis console.green-api.com

# 2Chat (si WHATSAPP_PROVIDER=twochat)
TWOCHAT_API_KEY=                    # clé API depuis app.2chat.io → Settings → API Keys
TWOCHAT_PHONE_NUMBER=               # numéro WhatsApp branché dans 2Chat, format +336...

# Meta / WhatsApp Cloud API (si WHATSAPP_PROVIDER=whatsapp_cloud)
META_ACCESS_TOKEN=
META_PHONE_NUMBER_ID=
META_APP_SECRET=

# Optionnel
NEXT_PUBLIC_SITE_URL=https://shul.fr
NEXT_PUBLIC_WHATSAPP_NUMBER=                # numéro affiché sur la landing (ex: +33612345678)
